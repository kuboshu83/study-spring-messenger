<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.infrastructure.repository.ApplicationGroupCommandDAO">
    <insert id="save" parameterType="org.example.infrastructure.repository.ApplicationGroupRegistrationDTO">
        INSERT INTO applications_groups VALUE (application_id, group_id)
        VALUES
        <foreach collection="registrations" item="registration" separator=",">
            (CAST(#{registration.applicationId} AS uuid), CAST(#{registration.groupId} AS uuid))
        </foreach>
    </insert>
</mapper>